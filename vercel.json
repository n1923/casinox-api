{
  "version": 2,
  "functions": {
    "api/*.ts": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "builds": [
    {
      "src": "api/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "lib/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ]
}